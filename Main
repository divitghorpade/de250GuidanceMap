<script>
const TYPES = {
  '4W': { label: '4-wheeler', noun: 'car' },
  '2W': { label: '2-wheeler', noun: 'bike' }
};
const LOTS = {
  vmcc:  { lot: 'P1', short: 'VMCC',  name: 'Victor Menezes Convention Centre',
           query: 'Victor Menezes Convention Centre, IIT Bombay, Powai, Mumbai',
           cap: { '4W': 10, '2W': 14 }, box: [165, 235, 215, 195] },
  rbtic: { lot: 'P2', short: 'RBTIC', name: 'Rahul Bajaj Technology Innovation Centre',
           query: 'Rahul Bajaj Technology Innovation Centre, IIT Bombay, Powai, Mumbai',
           cap: { '4W': 30, '2W': 40 }, box: [550, 230, 265, 190] },
  cese:  { lot: 'P3', short: 'CESE',  name: 'Centre for Environmental Science and Engineering',
           query: 'Centre for Environmental Science and Engineering, IIT Bombay, Powai, Mumbai',
           cap: { '4W': 12, '2W': 23 }, box: [480, 437, 200, 156] }
};
// Order in which lots are checked for each destination, nearest first.
const CHAIN = {
  vmcc:  ['vmcc', 'rbtic', 'cese'],
  rbtic: ['rbtic', 'cese', 'vmcc'],
  cese:  ['cese', 'rbtic', 'vmcc']
};
const PRESETS = {
  0: { vmcc: 'cap', rbtic: 'cap', cese: 'cap' },
  1: { vmcc: 0, rbtic: 'cap', cese: 'cap' },
  2: { vmcc: 0, rbtic: 0, cese: 'cap' }
};
const ROUTE = {
  vmcc:  'M840 10 V215 H420 V251',
  rbtic: 'M840 10 V215 H470 V325 H562',
  cese:  'M840 10 V215 H470 V490 H499'
};
const WALK = {
  'rbtic>vmcc': 'M578 341 V360 H372',
  'cese>vmcc':  'M499 490 L372 410',
  'vmcc>rbtic': 'M420 283 V300 H593',
  'cese>rbtic': 'M515 474 V425 H650 V382',
  'vmcc>cese':  'M436 283 H470 V515 H558',
  'rbtic>cese': 'M578 341 V425 H612 V448'
};

const free = {};
const state = { dest: 'vmcc', type: '4W', stage: 3 };
let timers = [];
let lastRoute = '';

function applyPreset(id) {
  const p = PRESETS[id];
  for (const k in LOTS) {
    free[k] = {};
    for (const t in TYPES) free[k][t] = p[k] === 'cap' ? LOTS[k].cap[t] : p[k];
  }
}
applyPreset(1);

const $ = (id) => document.getElementById(id);
const plural = (type, n) => TYPES[type].noun + (n === 1 ? '' : 's');
const tag = (k) => LOTS[k].lot + ' ' + LOTS[k].short;

function pickLot(destKey, type) {
  const chain = CHAIN[destKey];
  const idx = chain.findIndex((k) => free[k][type] > 0);
  return { lot: idx === -1 ? null : chain[idx], checked: idx === -1 ? chain : chain.slice(0, idx + 1) };
}

const mapsUrl = (key) =>
  'https://www.google.com/maps/dir/?api=1&travelmode=driving&destination=' + encodeURIComponent(LOTS[key].query);

function goButton(key) {
  return '<a class="go" href="' + mapsUrl(key) + '" target="_blank" rel="noopener">Open ' + LOTS[key].short +
    ' in Google Maps <span aria-hidden="true">&#8599;</span></a>' +
    '<p class="hint">Opens Google Maps in a new tab with driving directions from your current location.</p>';
}

function chainList(pick, type) {
  return '<ul class="chain">' + pick.checked.map((k) => {
    const n = free[k][type];
    return '<li class="' + (n > 0 ? 'good' : 'bad') + '"><b>' + tag(k) + '</b> &middot; ' +
      n + ' of ' + LOTS[k].cap[type] + ' ' + plural(type, 2) + ' free</li>';
  }).join('') + '</ul>';
}

function renderResult(pick) {
  const { dest, type, stage } = state;
  const d = LOTS[dest];
  const el = $('result');
  if (stage < 3) {
    el.innerHTML = '<div class="result wait"><p class="pill">Checking</p><p>Looking up free ' + TYPES[type].label + ' spaces near ' + d.short + '&hellip;</p></div>';
    return;
  }
  if (!pick.lot) {
    el.innerHTML = '<div class="result full"><p class="pill">No space</p><h2>No ' + TYPES[type].label + ' space nearby</h2>' +
      chainList(pick, type) + '<p>Every nearby lot is full for this vehicle type. Try again shortly.</p></div>';
    return;
  }
  const lot = LOTS[pick.lot];
  if (pick.lot === dest) {
    el.innerHTML = '<div class="result ok"><p class="pill">Space available</p><h2>Park at ' + lot.lot + ' ' + lot.short + '</h2>' +
      '<p>' + free[pick.lot][type] + ' of ' + lot.cap[type] + ' ' + plural(type, 2) + ' free at ' + lot.name + '.</p>' + goButton(pick.lot) + '</div>';
    return;
  }
  el.innerHTML = '<div class="result warn"><p class="pill">Lot full, rerouted</p><h2>Go to ' + lot.lot + ' ' + lot.short + ' instead</h2>' +
    chainList(pick, type) +
    '<p>Park at ' + lot.short + ', then walk to ' + d.short + ' (dotted line on the map).</p>' + goButton(pick.lot) + '</div>';
}

function renderSteps(pick) {
  const { dest, type, stage } = state;
  const full = pick.checked.filter((k) => free[k][type] === 0).map((k) => LOTS[k].short);
  const checkText = !pick.lot ? 'All nearby lots are full'
    : full.length ? full.join(' and ') + ' full, ' + LOTS[pick.lot].short + ' has space'
    : LOTS[dest].short + ' has space';
  const rows = [
    ['Destination and vehicle read', LOTS[dest].short + ' &middot; ' + TYPES[type].label],
    ['Free space checked, nearest lot first', checkText],
    ['Lot handed to Google Maps', pick.lot ? tag(pick.lot) + ' set as the destination' : 'Nothing to hand over']
  ];
  $('steps').innerHTML = rows.map((r, i) =>
    '<li class="' + (stage > i ? 'done' : '') + '"><span class="dot"></span><span>' + r[0] +
    (stage > i ? '<small>' + r[1] + '</small>' : '') + '</span></li>').join('');
}

function drawRoute(key) {
  const r = $('route');
  if (key === lastRoute) return;
  lastRoute = key;
  r.style.transition = 'none';
  r.style.strokeDashoffset = '1';
  if (!key) return;
  r.setAttribute('d', ROUTE[key]);
  void r.getBoundingClientRect();
  r.style.transition = 'stroke-dashoffset 1s ease-out';
  r.style.strokeDashoffset = '0';
}

function renderMap(pick) {
  const { dest, type, stage } = state;
  for (const k in LOTS) {
    const n = free[k][type];
    const cls = n > 0 ? 'ok' : 'full';
    $('pin-' + k).setAttribute('class', 'pin ' + cls);
    const s = $('s-' + k);
    s.setAttribute('class', 'b-stat ' + cls);
    s.textContent = LOTS[k].lot + ' · ' + (n > 0 ? n + ' free' : 'Full');
  }
  const [x, y, w, h] = LOTS[dest].box;
  const hl = $('hl');
  hl.setAttribute('x', x); hl.setAttribute('y', y); hl.setAttribute('width', w); hl.setAttribute('height', h);

  const show = stage === 3 && pick.lot;
  drawRoute(show ? pick.lot : '');
  const walk = $('walk');
  if (show && pick.lot !== dest) {
    walk.setAttribute('d', WALK[pick.lot + '>' + dest]);
    walk.style.opacity = '1';
  } else {
    walk.style.opacity = '0';
  }
}

function renderControls() {
  $('dest').value = state.dest;
  document.querySelectorAll('.seg button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.type === state.type)));
  $('lotctl').innerHTML = Object.keys(LOTS).map((k) =>
    '<div class="lot"><div class="lot-head"><b>' + tag(k) + '</b><span>' + LOTS[k].name + '</span></div>' +
    Object.keys(TYPES).map((t) =>
      '<div class="row"><span>' + TYPES[t].label + '</span>' +
      '<span class="free"><strong>' + free[k][t] + '</strong> / ' + LOTS[k].cap[t] + ' free</span>' +
      '<span class="step-btns">' +
      '<button type="button" data-lot="' + k + '" data-type="' + t + '" data-d="-1" aria-label="Remove one free ' + TYPES[t].label + ' space at ' + LOTS[k].short + '">&minus;</button>' +
      '<button type="button" data-lot="' + k + '" data-type="' + t + '" data-d="1" aria-label="Add one free ' + TYPES[t].label + ' space at ' + LOTS[k].short + '">+</button>' +
      '</span></div>').join('') + '</div>'
  ).join('');
}

function render() {
  const pick = pickLot(state.dest, state.type);
  renderControls();
  renderResult(pick);
  renderSteps(pick);
  renderMap(pick);
}

function runCheck() {
  timers.forEach(clearTimeout);
  timers = [];
  state.stage = 0;
  render();
  [1, 2, 3].forEach((s, i) => timers.push(setTimeout(() => { state.stage = s; render(); }, 300 + i * 450)));
}

$('dest').addEventListener('change', (e) => { state.dest = e.target.value; runCheck(); });
$('find').addEventListener('click', runCheck);
document.querySelector('.seg').addEventListener('click', (e) => {
  const b = e.target.closest('button');
  if (!b) return;
  state.type = b.dataset.type;
  runCheck();
});
document.querySelector('.presets').addEventListener('click', (e) => {
  const b = e.target.closest('button[data-preset]');
  if (!b) return;
  applyPreset(b.dataset.preset);
  state.dest = 'vmcc';
  runCheck();
});
$('lotctl').addEventListener('click', (e) => {
  const b = e.target.closest('button[data-lot]');
  if (!b) return;
  const { lot, type } = b.dataset;
  free[lot][type] = Math.min(LOTS[lot].cap[type], Math.max(0, free[lot][type] + Number(b.dataset.d)));
  timers.forEach(clearTimeout);
  state.stage = 3;
  render();
});

render();
</script>

</body>
</html>
